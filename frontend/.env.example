# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Production: set VITE_API_BASE in your host (Vercel, Netlify, Render static, etc.)
# to your deployed FastAPI backend URL (no trailing slash required).

# Production: set in Vercel → Project Settings → Environment Variables
# VITE_API_BASE=https://tokenmaxx-api.onrender.com

VITE_API_BASE=http://127.0.0.1:8001
