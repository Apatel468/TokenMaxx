# Copy this file to .env and add your Groq API key.
#   cp .env.example .env
#
# Without GROQ_API_KEY the app uses mock responses automatically.

GROQ_API_KEY=gsk-your-groq-key-here

# Auth — change JWT_SECRET in production; tokens expire after JWT_EXPIRE_HOURS (default 168 = 7 days)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# Optional: promote/create your real admin on startup (use your actual email)
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=your-secure-password-min-8-chars
