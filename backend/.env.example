# Copy to .env for local development:
#   cp .env.example .env

GROQ_API_KEY=gsk-your-groq-key-here

# Optional app-level keys for multi-provider routing (chat/regenerate)
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# GEMINI_API_KEY=your-gemini-key-here

# Auth — required in production (Render generates JWT_SECRET in render.yaml)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# SQLite (local default). On Render with a persistent disk use:
# DATABASE_URL=sqlite:////var/data/smartllm_router.db
# DATABASE_URL=sqlite:///./smartllm_router.db

# Comma-separated frontend origins for CORS (production)
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Optional: promote/create admin on startup
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=your-secure-password-min-8-chars

# ChromaDB persistence directory (default: backend/chroma_data/)
# CHROMA_PERSIST_DIR=./chroma_data

# Generated documents/images storage (default: backend/generated_data/)
# GENERATED_FILES_DIR=./generated_data

# Minimum cosine similarity (0-1) for RAG chunks in chat (default: 0.4)
# RAG_SIMILARITY_THRESHOLD=0.4

# API key encryption secret (falls back to JWT_SECRET if unset — MVP only)
# API_KEY_ENCRYPTION_SECRET=long-random-string

# When true, missing LLM keys use mock responses (default: true for local demos)
# ALLOW_MOCK_LLM=true

# Web research — Tavily (preferred) or Serper for live search
# TAVILY_API_KEY=tvly-your-key-here
# SERPER_API_KEY=your-serper-key-here

# Web scrape limits (optional)
# WEB_SCRAPE_TIMEOUT_SEC=15
# WEB_SCRAPE_MAX_BYTES=2097152
# WEB_SCRAPE_MAX_DURATION_SEC=45
