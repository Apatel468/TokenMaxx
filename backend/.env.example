# Copy to .env for local development:
#   cp .env.example .env

GROQ_API_KEY=gsk-your-groq-key-here

# Auth — required in production (Render generates JWT_SECRET in render.yaml)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# SQLite (local default). On Render with a persistent disk use:
# DATABASE_URL=sqlite:////var/data/smartllm_router.db
# DATABASE_URL=sqlite:///./smartllm_router.db

# Comma-separated frontend origins for CORS (production)
# CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Optional: promote/create admin on startup
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=your-secure-password-min-8-chars
